# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local - it is ignored by git.

# Required for real AI screening (without it the app runs in clearly-labelled demo mode)
ANTHROPIC_API_KEY=

# Optional - defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# Optional - max screenings per IP per hour (default 20)
RATE_LIMIT_PER_HOUR=20

# Optional - anonymous usage analytics in Supabase (see supabase/schema.sql)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
